{
  "route": {
    "rule_set+": [
      {
        "type": "remote",
        "tag": "uselessbug-direct-domain",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/uselessbug/OpenClash_Rule_Provider/sing-box/binary/direct-domain.srs",
        "download_detour": "proxy",
        "update_interval": "6h"
      },
      {
        "type": "remote",
        "tag": "uselessbug-direct-ip",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/uselessbug/OpenClash_Rule_Provider/sing-box/binary/direct-ip.srs",
        "download_detour": "proxy",
        "update_interval": "6h"
      }
    ],
    "+rules": [
      {
        "rule_set": [
          "uselessbug-direct-domain",
          "uselessbug-direct-ip"
        ],
        "outbound": "bypass"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
