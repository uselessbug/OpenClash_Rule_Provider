{
  "route": {
    "rule_set+": [
      {
        "type": "remote",
        "tag": "uselessbug-direct",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/uselessbug/OpenClash_Rule_Provider/sing-box/binary/direct.srs",
        "download_detour": "proxy",
        "update_interval": "6h"
      }
    ],
    "+rules": [
      {
        "rule_set": [
          "uselessbug-direct"
        ],
        "outbound": "bypass"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
